  "services": [
    { "id": "production_completion_service", "name": "⚠ ProductionCompletionService (inferred)", "boundedContext": "production", "description": "Coordinates the can_produce / complete_production_order RPCs: produces the finished item and deducts its DIRECT BOM components only (since STORY-068, migration 20261005000000 — a sub-assembly is stocked and built by its own order, so its own parts are not deducted again). Takes advisory locks per consumed component via stock_lock_key / lock_stock_keys before re-reading stock (STORY-043, migration 20260926000000); a shortfall raises SK409 → HTTP 409 insufficient_stock. Spans the Item, ProductionOrder and StockLedger aggregates.", "status": "built" },
    { "id": "workflow_review_service", "name": "⚠ WorkflowReviewService (inferred)", "boundedContext": "workflow", "description": "Coordinates submit_proposal / review_proposal RPCs: walks the tenant's workflow_steps chain matching the reviewer's actual role_id, and on final approval of a bom_change proposal atomically applies the payload via apply_bom_change_payload. Spans the Proposal and Item aggregates.", "status": "built" },
    { "id": "permission_sync_service", "name": "⚠ PermissionSyncService (inferred)", "boundedContext": "identity_access", "description": "When a Role's permissions are edited, pushes the new permissions snapshot into every current member's Supabase app_metadata (JWT claims) via roles.ts, since permissions are baked into the token at invite time rather than looked up live.", "status": "built" },
    { "id": "job_dispatch_service", "name": "JobDispatchService", "boundedContext": "jobs_reservations", "description": "ADR-001 (accepted) / STORY-031: one shared Cloudflare Queue + one generic consumer Worker that dispatches on job.type (csv_import | pdf_generation | label_printing), writing output to R2 and updating the jobs table for client polling (GET /api/jobs/:id).", "status": "planned" },
    { "id": "stock_reservation_service", "name": "StockReservationService", "boundedContext": "jobs_reservations", "description": "ADR-001 (accepted) / STORY-035: wraps the reserve_stock / release_reservation RPC pair. Locking uses pg_advisory_xact_lock via the shared stock_lock_key / lock_stock_keys helpers from STORY-043 — not FOR UPDATE (ADR-001 amendment 2026-09-26). Spans the Item and ProductionOrder aggregates. Reservation storage shape (table vs. view) not decided yet.", "status": "planned" },
    { "id": "stock_move_service", "name": "StockMoveService", "boundedContext": "warehouse_ops", "description": "ADR-002 (accepted) / STORY-038: wraps the move_stock RPC — one atomic transaction writing a negative stock_ledger row at the source location and a positive one at the destination, reason 'moved', using the shared stock-lock helpers. Never a raw location field update.", "status": "planned" },
    { "id": "where_used_service", "name": "WhereUsedService", "boundedContext": "catalog", "status": "planned", "description": "STORY-056 (accepted, sprint 2): GET /api/bom/:itemId/where-used, a recursive-CTE RPC walking bom_lines upwards (child → parent → …) with depth and cumulative quantity. Reused by ProposalImpactService and replace-everywhere proposals (STORY-059)." },
    { "id": "proposal_impact_service", "name": "ProposalImpactService", "boundedContext": "workflow", "status": "proposed", "description": "STORY-057 (staging): one Postgres function computing a bom_change proposal's impact live — affected products (via where-used), stock of added/removed parts, and whether open production orders can still be built. Informational only; no cost section." },
    { "id": "approval_chain_service", "name": "ApprovalChainService", "boundedContext": "workflow", "status": "proposed", "description": "STORY-058 (staging): list / atomically replace the ordered workflow_steps per proposal type, gated by admin.manage_workflow. In-flight proposals keep a snapshot of their chain (snapshot shape not decided); resubmitting restarts at step 1." },
    { "id": "goods_receipt_service", "name": "GoodsReceiptService", "boundedContext": "purchasing", "status": "proposed", "description": "STORY-051 (staging): receive_purchase_order RPC — per line writes a positive stock_ledger row (reason received, reference_type purchase_order), raises quantity_received and sets the order to partially_received / received, locking the purchase_orders row. Spans PurchaseOrder and StockLedger." },
    { "id": "stock_count_posting_service", "name": "StockCountPostingService", "boundedContext": "inventory", "status": "proposed", "description": "STORY-053 (staging): post_stock_count RPC — per line writes counted − current system quantity as a stock_ledger row (reason counted, reference_type stock_count), using the shared stock-lock helpers; lines above the tenant threshold need inventory.approve_count. Spans StockCount and StockLedger." }
