  "repositories": [
    { "id": "tenant_repo", "name": "⚠ TenantRepository (inferred)", "aggregateId": "tenant", "methods": ["provision(tenant, adminUser)", "findBySlug(slug)"], "description": "Mapped from server/src/routes/tenants.ts — no literal Repository class exists; Supabase admin client + provision_tenant RPC play this role.", "status": "built" },
    { "id": "role_repo", "name": "⚠ RoleRepository (inferred)", "aggregateId": "role", "methods": ["list(tenantId)", "create(role)", "update(id, permissions)"], "description": "Mapped from server/src/routes/roles.ts.", "status": "built" },
    { "id": "profile_repo", "name": "⚠ ProfileRepository (inferred)", "aggregateId": "profile", "methods": ["list(tenantId)", "invite(email, roleId)", "reassignRole(id, roleId)"], "description": "Mapped from server/src/routes/users.ts.", "status": "built" },
    { "id": "item_repo", "name": "⚠ ItemRepository (inferred)", "aggregateId": "item", "methods": ["findById(id)", "list(tenantId, cursor)", "create(item)", "update(id, patch)", "archive(id)"], "description": "Mapped from server/src/routes/items.ts. BomLine has no separate repository — CLAUDE.md itself notes BOM lines are only reachable through this item aggregate, indirectly via bom_change proposals or bom.ts's tree/add endpoints.", "status": "built" },
    { "id": "stock_ledger_repo", "name": "⚠ StockLedgerRepository (inferred)", "aggregateId": "stock_ledger", "methods": ["append(entry)", "listByItem(itemId)", "currentStock(itemId)"], "description": "Mapped from server/src/routes/inventory.ts. Deliberately has no update/delete methods — matches Non-Negotiable Security Rule 3 (append-only ledger).", "status": "built" },
    { "id": "production_order_repo", "name": "⚠ ProductionOrderRepository (inferred)", "aggregateId": "production_order", "methods": ["findById(id)", "list(tenantId, cursor)", "create(order)", "complete(id)"], "description": "Mapped from server/src/routes/production.ts; complete() wraps the complete_production_order RPC.", "status": "built" },
    { "id": "proposal_repo", "name": "⚠ ProposalRepository (inferred)", "aggregateId": "proposal", "methods": ["findById(id)", "list(tenantId)", "create(proposal)", "submit(id)", "review(id, action)"], "description": "Mapped from server/src/routes/proposals.ts.", "status": "built" }
  ],
  "factories": [
    { "id": "tenant_factory", "name": "⚠ TenantFactory (inferred)", "aggregateId": "tenant", "description": "Wraps the provision_tenant RPC: creates the tenant + default Admin role + first profile + one workflow_step per proposal type, atomically, in a single transaction.", "status": "built" }
  ],
  "services": [
    { "id": "production_completion_service", "name": "⚠ ProductionCompletionService (inferred)", "boundedContext": "production", "description": "Coordinates the complete_production_order RPC: produces the finished item and deducts every recursively-required BOM component from stock_ledger in one transaction. Spans the Item, ProductionOrder and StockLedger aggregates, so it can't live on any single one of them.", "status": "built" },
    { "id": "workflow_review_service", "name": "⚠ WorkflowReviewService (inferred)", "boundedContext": "workflow", "description": "Coordinates submit_proposal / review_proposal RPCs: walks the tenant's workflow_steps chain matching the reviewer's actual role_id, and on final approval of a bom_change proposal atomically applies the payload via apply_bom_change_payload. Spans the Proposal and Item aggregates.", "status": "built" },
    { "id": "permission_sync_service", "name": "⚠ PermissionSyncService (inferred)", "boundedContext": "identity_access", "description": "When a Role's permissions are edited, pushes the new permissions snapshot into every current member's Supabase app_metadata (JWT claims) via roles.ts, since permissions are baked into the token at invite time rather than looked up live.", "status": "built" },
    { "id": "job_dispatch_service", "name": "JobDispatchService", "boundedContext": "jobs_reservations", "description": "Proposed in ADR-001: one shared Cloudflare Queue + one generic consumer Worker that dispatches on a job.type field (csv_import | pdf_generation | label_printing), writing output to R2 and updating the jobs table for client polling (GET /jobs/:id). Explicitly one shared pattern instead of three bespoke ones.", "status": "proposed" },
    { "id": "stock_reservation_service", "name": "StockReservationService", "boundedContext": "jobs_reservations", "description": "Proposed in ADR-001: wraps the reserve_stock / release_reservation RPC pair using row-level locking (SELECT ... FOR UPDATE), following the same pattern as complete_production_order. Spans the Item and ProductionOrder aggregates. Detailed schema not yet designed — see ADR-001 Consequences.", "status": "proposed" },
    { "id": "stock_move_service", "name": "StockMoveService", "boundedContext": "warehouse_ops", "description": "Proposed in ADR-002: wraps the move_stock RPC — one atomic transaction writing a negative stock_ledger row at the source location and a positive one at the destination, reason 'moved'. Never a raw location field update.", "status": "proposed" }
  ],
  "domainEvents": []
}
